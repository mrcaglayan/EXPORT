NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=export_accounting_dev
DB_USER=export_app
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
# Exact comma-separated browser origins. Required explicitly in production.
CORS_ORIGIN=http://localhost:5173
AUTH_SECRET=
AUTH_SESSION_SECONDS=28800
# AUTH_SECRET: at least 32 random bytes encoded as hex; never expose to frontend.
# One-time CLI-only setup: SETUP_TENANT_CODE, SETUP_TENANT_NAME,
# SETUP_ENTITY_CODE, SETUP_ENTITY_NAME, SETUP_ADMIN_EMAIL, SETUP_ADMIN_NAME,
# SETUP_ADMIN_PASSWORD (15+ characters, at most 72 UTF-8 bytes).
# Migration CLI only, when separate DDL credentials are needed:
# MIGRATION_DB_USER and MIGRATION_DB_PASSWORD must both be supplied to that
# process. Keep them out of the running API environment. For the repository-owned
# development instance, use npm run db:migrate:local instead.
